**/*/target
.idea
/agent

# Internal reference material (docs, deferred notes, code references) — kept locally,
# not published. The marketing site lives at compositor.website (tracked).
/.reference/

# Release / install artifacts — regenerated by compositor.installer/prepare.sh.
# These are large prebuilt binaries that blow past GitHub's 100 MB limit; never commit them.
compositor.installer/dist/

# Debian/PPA offline vendor trees (packed into *.orig.tar.xz by debian/scripts/make-orig.sh).
/cargo-vendor/
/npm-vendor/
/rust-toolchain-dist/