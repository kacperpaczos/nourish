tar-ignore = ^.git($|/)
tar-ignore = (^|/)target($|/)
tar-ignore = (^|/)\.cache($|/)
tar-ignore = (^|/)node_modules($|/)
# cargo-vendor/, npm-vendor/ and rust-toolchain-dist/ are a REQUIRED part of
# the orig tarball (packed by debian/scripts/make-orig.sh — Launchpad has no
# network). extend-diff-ignore only keeps local vendor drift out of the
# auto-generated quilt patch; it does NOT exclude them from the orig.
extend-diff-ignore = ^cargo-vendor/
extend-diff-ignore = ^npm-vendor/
extend-diff-ignore = ^rust-toolchain-dist/
# Gitignored Tauri build outputs the binary build legitimately writes into the
# working tree; without these, a source build after a binary build fails with
# "unexpected upstream changes".
extend-diff-ignore = (^|/)logs/dist/bundle\.(js|css|js\.map)$
extend-diff-ignore = (^|/)src-tauri/gen/
tar-ignore = ^debian/stage($|/)
tar-ignore = ^debian/tmp
tar-ignore = ^debian/cargo-home
tar-ignore = ^debian/cargo-target
tar-ignore = ^debian/rustup-home
tar-ignore = ^debian/cargo-home-build
tar-ignore = ^debian/package\.tar\.gz$
tar-ignore = ^debian/SHA256SUMS$
tar-ignore = ^debian/files$
tar-ignore = ^debian/y5-compositor($|/)
tar-ignore = ^debian/y5-compositor-settings($|/)
tar-ignore = ^debian/y5-compositor-monitor($|/)
tar-ignore = ^debian/y5-polkit-agent($|/)
tar-ignore = ^debian/y5-xwayland-satellite($|/)
tar-ignore = ^debian/y5-mx-gesture-daemon($|/)
tar-ignore = ^debian/y5-compositor-full($|/)
tar-ignore = ^debian/\.debhelper($|/)
