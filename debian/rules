#!/usr/bin/make -f
# Track B (Ubuntu PPA): compile via debian/scripts/build-bundle.sh only.
# Never invoke compositor.installer/prepare.sh — see document/DISTRIBUTION.md.

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export Y5_SKIP_LINT = 1

# Cap cargo parallelism: linking the Bevy/wgpu binaries is extremely
# memory-hungry and an uncapped `cargo build` OOMs small builders.
# Honour DEB_BUILD_OPTIONS parallel=N; default conservatively to 2.
ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
export CARGO_BUILD_JOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
else
export CARGO_BUILD_JOBS = 2
endif
export Y5_TARGET_DIR = $(CURDIR)/debian/cargo-target
export CARGO_HOME = $(CURDIR)/debian/cargo-home-build
export CARGO_NET_OFFLINE = true

%:
	dh $@

# dh_clean deletes *.orig by default; cargo-vendor checksums require Cargo.toml.orig.
override_dh_clean:
	dh_clean -X.orig

override_dh_auto_clean:
	rm -rf \
		debian/tmp \
		debian/stage \
		debian/tmp-stage \
		debian/cargo-home-build \
		debian/cargo-target \
		debian/y5-compositor \
		debian/y5-compositor-settings \
		debian/y5-compositor-monitor \
		debian/y5-polkit-agent \
		debian/y5-xwayland-satellite \
		debian/y5-mx-gesture-daemon \
		debian/y5-compositor-full \
		debian/.debhelper \
		debian/rustup-home-empty \
		compositor.developer/developer.tool/developer.tool.window/logs/node_modules
	# Restore generated per-project vendor configs; keep cargo-vendor/ + npm-vendor/.
	@find . -type f -name 'config.toml' -path '*/.cargo/*' \
		-not -path './vendor/*' \
		-not -path './.cargo/config.toml' \
		-not -path './cargo-vendor/*' 2>/dev/null | while read -r cfg; do \
		if grep -q 'y5-debian-vendor' "$$cfg" 2>/dev/null; then \
			if [ -f "$${cfg}.y5-bak" ]; then mv -f "$${cfg}.y5-bak" "$$cfg"; \
			else rm -f "$$cfg"; fi; \
		fi; \
	done
	# Component target dirs created during the package build.
	rm -rf \
		compositor.installer/component/pollkit-agent/target \
		compositor.installer/component/mx-gesture-daemon/target \
		compositor.installer/component/settings-editor/target \
		compositor.installer/component/xwayland-satellite/xwayland-fixes/target \
		compositor.developer/developer.tool/developer.tool.window/logs/src-tauri/target

override_dh_auto_configure:
	@test -d $(CURDIR)/cargo-vendor/compositor \
		|| { echo "debian/rules: cargo-vendor/ missing — rebuild orig with debian/scripts/make-orig.sh" >&2; exit 1; }
	@test -f $(CURDIR)/npm-vendor/logs-node_modules.tar.xz \
		|| { echo "debian/rules: npm-vendor/ missing — rebuild orig with debian/scripts/make-orig.sh" >&2; exit 1; }
	@test -x $(CURDIR)/rust-toolchain-dist/bin/rustc \
		|| { echo "debian/rules: rust-toolchain-dist/ missing — run debian/scripts/bundle-rust-toolchain.sh / make-orig.sh" >&2; exit 1; }

override_dh_auto_build:
	debian/scripts/build-bundle.sh

override_dh_auto_install:
	debian/scripts/install-packages.sh

# Never enable user units globally: y5.service / xwayland.service carry
# [Install] WantedBy=graphical-session.target, and a --global enable would
# start the compositor inside GNOME/KDE sessions. The Wayland session entry
# in wayland-sessions/ is the only intended entry point.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# Bevy/Vulkan binaries are huge; dwz is not useful here.
override_dh_dwz:
	:

# We install directly into debian/<pkg>/; nothing is left in debian/tmp.
override_dh_missing:
	dh_missing --list-missing
