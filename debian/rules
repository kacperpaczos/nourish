#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export Y5_SKIP_LINT = 1
export Y5_TARGET_DIR = $(CURDIR)/debian/cargo-target
export CARGO_HOME = $(CURDIR)/debian/cargo-home
export RUSTUP_HOME = $(CURDIR)/debian/rustup-home
export PATH := $(CURDIR)/debian/cargo-home/bin:$(PATH)

%:
	dh $@

override_dh_auto_clean:
	rm -rf debian/tmp debian/rustup-init

override_dh_auto_build:
	@if [ ! -f debian/stage/binaries/y5.compositor ]; then \
		./link.all.sh; \
		if ! ( command -v rustc >/dev/null 2>&1 \
			&& rustc --version | grep -qE 'rustc 1\.(8[5-9]|[9][0-9]|[1-9][0-9]{2,})' ); then \
			curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o $(CURDIR)/debian/rustup-init \
			&& sh $(CURDIR)/debian/rustup-init -y --no-modify-path --profile minimal --default-toolchain stable \
			&& rm -f $(CURDIR)/debian/rustup-init; \
		fi; \
		compositor.installer/prepare.sh --out=$(CURDIR)/debian --skip=installer; \
	fi

override_dh_auto_install:
	debian/install-from-stage.sh debian/y5-compositor

override_dh_install:
	:

override_dh_missing:
	:

override_dh_dwz:
	:
