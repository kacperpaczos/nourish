#!/bin/bash
# /usr/libexec/y5-compositor/session — ExecStart of y5.service
set -euo pipefail

export XDG_CURRENT_DESKTOP=Y5Compositor
export XDG_SESSION_TYPE=wayland

# The compositor reads ALL of its configuration from settings.json (every
# field required; it panics if the file is missing or partial). On first
# start, seed the canonical complete defaults via the settings tool's
# non-interactive mode — the same template the Track A installer seeds
# (config.base::default_settings). y5-compositor-settings is a hard
# Depends, so the tool is always present. An existing file is NEVER
# touched; customize with 'y5.compositor.settings'.
_y5_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/y5.compositor"
if [ ! -f "$_y5_cfg/settings.json" ]; then
	echo "y5: no configuration at $_y5_cfg/settings.json — seeding defaults" >&2
	if ! /usr/bin/y5.compositor.settings --write-default >&2; then
		echo "y5: seeding defaults failed; run 'y5.compositor.settings' manually." >&2
		exit 1
	fi
fi

exec /usr/bin/y5.compositor
