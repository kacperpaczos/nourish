[Unit]
Description=Y5 Wayland compositor (Y5 Compositor)
BindsTo=graphical-session.target
Before=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=xdg-desktop-autostart.target
Before=xdg-desktop-autostart.target
Wants=y5-polkit-agent.service
Wants=xwayland.service
After=y5-polkit-agent.service

[Service]
Slice=session.slice
Type=exec
ExecStart=/usr/libexec/y5-compositor/session
# Tear down leftover session units (polkit agent etc.) once the compositor
# exits; y5.shutdown.target Conflicts=graphical-session.target.
ExecStopPost=-/usr/bin/systemctl --user start y5.shutdown.target

[Install]
WantedBy=graphical-session.target
